generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  bio               String?        @db.Text
  profileBackground String?        @db.Text
  avatarFrame       String?
  featuredBookIds   String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  books             UserBook[]
  wishlistItems     WishlistItem[]
  quotes            UserQuote[]

  @@map("users")
}

model UserBook {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  author            String
  coverUrl          String?          @db.Text
  totalPages        Int              @default(1)
  currentPage       Int              @default(0)
  currentPercentage Float            @default(0)
  status            String           @default("READING")
  notes             String?          @db.Text
  rating            Float?
  genre             String?
  startDate         DateTime?
  finishDate        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          ReadingSession[]

  @@index([userId])
  @@map("user_books")
}

model ReadingSession {
  id             String    @id @default(uuid())
  userBookId     String
  userBook       UserBook  @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  pageRead       Int
  percentageRead Float
  readDate       DateTime  @default(now())
  comment        String?   @db.Text
  emotions       String    @db.Text
  createdAt      DateTime  @default(now())

  @@index([userBookId])
  @@map("reading_sessions")
}

model WishlistItem {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBookId     String?
  title          String
  author         String
  isbn           String?
  coverUrl       String?        @db.Text
  initialPrice   Float
  currentPrice   Float
  lowestPrice    Float
  targetPrice    Float?
  storeName      String?
  productUrl     String?        @db.Text
  lastCheckedAt  DateTime       @default(now())
  priceDropped   Boolean        @default(false)
  percentDrop    Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  history        PriceHistory[]

  @@index([userId])
  @@map("wishlist_items")
}

model PriceHistory {
  id             String       @id @default(uuid())
  wishlistId     String
  wishlistItem   WishlistItem @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  price          Float
  storeName      String?
  recordedAt     DateTime     @default(now())

  @@index([wishlistId])
  @@map("price_history")
}

model UserQuote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookTitle  String
  author     String?
  quote      String   @db.Text
  pageNumber Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("user_quotes")
}
