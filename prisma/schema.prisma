generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  bio               String?
  profileBackground String?        // theme id or custom url
  themeColor        String?        @default("steam_midnight") // center container color
  themeOpacity      Int?           @default(85) // 20 to 100 percent
  replayMonth       String?        @default("current") // "current" or "YYYY-MM"
  readingGoal       Int?           @default(12) // books per year
  avatarFrame       String?        // gold, cosmic, emerald, flame, neon
  featuredBookIds   String?        // JSON array of book IDs: '["id1", "id2"]'
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  books             UserBook[]
  wishlistItems     WishlistItem[]
  quotes            UserQuote[]
  crewMembers       CrewMember[]   @relation("CrewCaptains")
  captainsJoined    CrewMember[]   @relation("CrewMembers")
  recommendations   BookRecommendation[]

  @@map("users")
}

model CrewMember {
  id          String   @id @default(uuid())
  captainId   String   // the user being followed
  memberId    String   // the follower
  createdAt   DateTime @default(now())

  captain     User     @relation("CrewCaptains", fields: [captainId], references: [id], onDelete: Cascade)
  member      User     @relation("CrewMembers", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([captainId, memberId])
  @@index([captainId])
  @@index([memberId])
  @@map("crew_members")
}

model BookRecommendation {
  id          String   @id @default(uuid())
  senderId    String
  userBookId  String?
  bookTitle   String
  author      String
  coverUrl    String?
  note        String?
  createdAt   DateTime @default(now())

  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@map("book_recommendations")
}

model UserBook {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  author            String
  coverUrl          String?
  totalPages        Int              @default(1)
  currentPage       Int              @default(0)
  currentPercentage Float            @default(0)
  status            String           @default("READING") // READING, WANT_TO_READ, READ, DROPPED
  notes             String?
  rating            Float?
  genre             String?
  startDate         DateTime?
  finishDate        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          ReadingSession[]

  @@index([userId])
  @@map("user_books")
}

model ReadingSession {
  id             String    @id @default(uuid())
  userBookId     String
  userBook       UserBook  @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  pageRead       Int
  percentageRead Float
  readDate       DateTime  @default(now())
  comment        String?
  emotions       String    // JSON string array of emotion IDs: '["curiosa", "empolgada"]'
  createdAt      DateTime  @default(now())

  @@index([userBookId])
  @@map("reading_sessions")
}

model WishlistItem {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBookId     String?
  title          String
  author         String
  isbn           String?
  coverUrl       String?
  initialPrice   Float
  currentPrice   Float
  lowestPrice    Float
  targetPrice    Float?
  storeName      String?
  productUrl     String?
  lastCheckedAt  DateTime       @default(now())
  priceDropped   Boolean        @default(false)
  percentDrop    Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  history        PriceHistory[]

  @@index([userId])
  @@map("wishlist_items")
}

model PriceHistory {
  id             String       @id @default(uuid())
  wishlistId     String
  wishlistItem   WishlistItem @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  price          Float
  storeName      String?
  recordedAt     DateTime     @default(now())

  @@index([wishlistId])
  @@map("price_history")
}

model UserQuote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookTitle  String
  author     String?
  quote      String
  pageNumber Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("user_quotes")
}
